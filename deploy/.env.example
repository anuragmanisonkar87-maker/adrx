# AdRx website settings. setup-server.sh copies this file to deploy/.env, which updates never overwrite.
# After changing a value, apply it with:  cd deploy && docker compose up -d --build

# Web address. setup-server.sh fills this in: your free DuckDNS name or your own domain gets HTTPS.
# ":80" means plain http on the server's IP address (only for a first test).
SITE_ADDRESS=:80

# Visitors' view: no set-up hints, no developer API pages
PUBLIC_SITE=true

# Sign-in: every check needs an account; the admin manages accounts on the site's Users page (/admin).
REQUIRE_LOGIN=on
ADMIN_USERNAME=admin
# First password of the admin account (at least 10 characters). setup-server.sh fills in a random one.
ADMIN_PASSWORD=
# Accounts are kept in the app's data volume. To keep them in Supabase (or another Postgres) instead, paste its
# connection string, e.g. postgresql://postgres.abcd:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# AI review stays off on the website. With an Anthropic key, every visitor's check would cost you money.
AI_REVIEW=off

# Limits per account (or per IP address without sign-in)
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=60
# Files checked at the same time; the next visitor waits up to QUEUE_WAIT_SECONDS for a turn
MAX_PARALLEL_CHECKS=2
QUEUE_WAIT_SECONDS=120
MAX_UPLOAD_MB=100
# Largest upload the web server lets through; keep it a little above MAX_UPLOAD_MB
PROXY_MAX_BODY=110MB
# Audio and video: only the first 3 minutes are checked
MAX_MEDIA_SECONDS=180
MAX_PDF_PAGES=20

# Speech-to-text; the model is downloaded into the app when it is built
TRANSCRIBE_BACKEND=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OCR_LANGUAGES=eng+hin

# Logs: see them with "docker compose logs app"
LOG_FILE=
LOG_LEVEL=INFO
