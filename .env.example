# Copy this file to .env (same folder) and fill in what you need.
# Values in .env take priority over variables already set in your terminal.

# --- AI review with Claude (recommended) ----------------------------------------
# Without a key the tool still works in "quick check" mode (phrase rules only).
# Get a key at https://platform.claude.com/settings/keys (it starts with sk-ant-)
ANTHROPIC_API_KEY=
# Only if your key is NOT scoped to a workspace: the workspace ID (wrkspc_...) from
# https://platform.claude.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=
AI_REVIEW_MODEL=claude-sonnet-5-5
# low | medium | high  (lower = faster and cheaper, higher = more thorough)
AI_REVIEW_EFFORT=medium
AI_MAX_TOKENS=16000
AI_TIMEOUT_SECONDS=180
AI_MAX_IMAGES=6

# --- Speech-to-text for audio notes and videos -------------------------------
# local  = faster-whisper on this machine (model downloads on first use)
# openai = any OpenAI-compatible transcription API (OpenAI, Groq, ...)
# none   = skip speech; videos are checked on their on-screen text only
TRANSCRIBE_BACKEND=local
# small is quick on CPU; large-v3-turbo is much better for Hindi/Hinglish (slower on CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Only for TRANSCRIBE_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Groq example (free key at https://console.groq.com/keys; large-v3 is its most accurate model for Hindi):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_TRANSCRIBE_MODEL=whisper-large-v3

# --- OCR and limits ------------------------------------------------------------
OCR_LANGUAGES=eng+hin
# Only if Tesseract is installed somewhere unusual (the app finds the standard Windows folder itself)
TESSERACT_CMD=
MAX_UPLOAD_MB=500
MAX_MEDIA_SECONDS=600
MAX_PDF_PAGES=30
MAX_TEXT_CHARS=30000

# --- Sign-in and user accounts (optional; README "Sign-in and user accounts") ------
# on = every page and check needs an account; the admin manages accounts at /admin
REQUIRE_LOGIN=off
ADMIN_USERNAME=admin
# First password of the admin account (at least 10 characters); used only while that account doesn't exist
ADMIN_PASSWORD=
# Where accounts are kept: empty = data/accounts.db in this folder; or a Supabase / Postgres connection string
DATABASE_URL=

# --- Optional single shared password for a quick demo (simpler than accounts) ----
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
